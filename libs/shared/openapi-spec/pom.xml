<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.spectrayan.promptly</groupId>
        <artifactId>promptly</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>promptly-openapi-spec</artifactId>
    <packaging>pom</packaging>
    <name>promptly-openapi-spec</name>
    <description>OpenAPI specification — generates Java APIs and Angular SDK from contract</description>

    <properties>
        <!-- Output directories relative to this module -->
        <apis.output>${project.basedir}/../apis/v1/promptly-apis</apis.output>
        <angular.sdk.output>${project.basedir}/../sdks/v1/angular/promptly-client</angular.sdk.output>
        <openapi.spec.dir>${project.basedir}/src/main/resources/openapi</openapi.spec.dir>
        <openapi.bundled.spec>${openapi.spec.dir}/bundled-promptly-v1.yaml</openapi.bundled.spec>
    </properties>

    <profiles>
        <profile>
            <id>openapi-gen</id>
            <build>
                <plugins>
                    <!-- ════════════════════════════════════════════════════════════
                         Step 1: Bundle multi-file OpenAPI spec into a single file.
                         Resolves all $ref pointers to internal #/components/schemas/X
                         references, ensuring the generator produces clean, named DTOs
                         without needing fragile inlineSchemaNameMappings.
                         ════════════════════════════════════════════════════════════ -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>bundle-openapi-spec</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>npx</executable>
                                    <arguments>
                                        <argument>-y</argument>
                                        <argument>@redocly/cli</argument>
                                        <argument>bundle</argument>
                                        <argument>${openapi.spec.dir}/promptly-v1.yaml</argument>
                                        <argument>-o</argument>
                                        <argument>${openapi.bundled.spec}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>${openapi-generator.version}</version>
                        <executions>
                            <!-- ════════════════════════════════════════════════════════════
                                 Step 2a: Generate Spring Java interfaces + DTOs
                                 Phase: generate-sources
                                 Uses the bundled spec — all schemas are already resolved
                                 to named component schemas, so no inline mapping needed.
                                 ════════════════════════════════════════════════════════════ -->
                            <execution>
                                <id>generate-java-server</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${openapi.bundled.spec}</inputSpec>
                                    <generatorName>spring</generatorName>
                                    <output>${apis.output}</output>

                                    <apiPackage>com.spectrayan.promptly.infrastructure.in.web.api</apiPackage>
                                    <modelPackage>com.spectrayan.promptly.infrastructure.in.web.dto</modelPackage>

                                    <generateApiTests>false</generateApiTests>
                                    <generateModelTests>false</generateModelTests>
                                    <generateSupportingFiles>true</generateSupportingFiles>

                                    <openapiNormalizer>
                                        <REF_AS_PARENT_IN_ALLOF>true</REF_AS_PARENT_IN_ALLOF>
                                    </openapiNormalizer>

                                    <configOptions>
                                        <interfaceOnly>true</interfaceOnly>
                                        <skipDefaultInterface>true</skipDefaultInterface>
                                        <reactive>true</reactive>
                                        <useSpringBoot3>true</useSpringBoot3>
                                        <jakarta>true</jakarta>
                                        <dateLibrary>java8</dateLibrary>
                                        <openApiNullable>false</openApiNullable>
                                        <documentationProvider>springdoc</documentationProvider>
                                        <useTags>true</useTags>
                                        <sourceFolder>src/main/java</sourceFolder>
                                        <!-- TODO: replace importMapping with <useJspecify>true</useJspecify>
                                             when upgrading openapi-generator beyond 7.21.0 -->
                                    </configOptions>

                                    <!-- Use jspecify @Nullable instead of deprecated Spring @Nullable (Spring 7+) -->
                                    <importMappings>
                                        <importMapping>Nullable=org.jspecify.annotations.Nullable</importMapping>
                                    </importMappings>
                                </configuration>
                            </execution>

                            <!-- ════════════════════════════════════════════════════════════
                                 Step 2b: Generate Angular TypeScript client SDK
                                 Phase: generate-sources
                                 ════════════════════════════════════════════════════════════ -->
                            <execution>
                                <id>generate-angular-client</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${openapi.bundled.spec}</inputSpec>
                                    <generatorName>typescript-angular</generatorName>
                                    <output>${angular.sdk.output}</output>

                                    <generateApiTests>false</generateApiTests>
                                    <generateModelTests>false</generateModelTests>
                                    <generateSupportingFiles>true</generateSupportingFiles>

                                    <openapiNormalizer>
                                        <REF_AS_PARENT_IN_ALLOF>true</REF_AS_PARENT_IN_ALLOF>
                                    </openapiNormalizer>

                                    <configOptions>
                                        <npmName>@promptly/client</npmName>
                                        <npmVersion>1.0.0</npmVersion>
                                        <ngVersion>19.0.0</ngVersion>
                                        <supportsES6>true</supportsES6>
                                        <withInterfaces>true</withInterfaces>
                                        <useSingleRequestParameter>true</useSingleRequestParameter>
                                        <fileNaming>kebab-case</fileNaming>
                                        <modelFileSuffix>.model</modelFileSuffix>
                                        <serviceFileSuffix>.service</serviceFileSuffix>
                                        <serviceSuffix>Service</serviceSuffix>
                                    </configOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ════════════════════════════════════════════════════════════════
             Profile: query-sdks
             Generates read-only (GET-only) client SDKs for external consumers.
             Filters by the "PublicApi" tag — only operations tagged with
             PublicApi are included. Currently targets Python and TypeScript.
             Usage: mvn generate-sources -f libs/shared/openapi-spec/pom.xml -P openapi-gen,query-sdks
             ════════════════════════════════════════════════════════════════ -->
        <profile>
            <id>query-sdks</id>
            <properties>
                <query.sdk.output>${project.basedir}/../sdks/v1/query</query.sdk.output>
                <query.sdk.version>1.0.0</query.sdk.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>${openapi-generator.version}</version>
                        <executions>

                            <!-- ─── Python SDK ─── -->
                            <execution>
                                <id>query-sdk-python</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <inputSpec>${openapi.bundled.spec}</inputSpec>
                                    <generatorName>python</generatorName>
                                    <output>${query.sdk.output}/python/promptly-query</output>

                                    <generateApiTests>false</generateApiTests>
                                    <generateModelTests>false</generateModelTests>

                                    <openapiNormalizer>
                                        <REF_AS_PARENT_IN_ALLOF>true</REF_AS_PARENT_IN_ALLOF>
                                    </openapiNormalizer>

                                    <globalProperties>
                                        <apis>PromptlyQuery</apis>
                                        <models>ProjectResponse,PromptResponse,PromptSummaryResponse,PromptStatus,ContentFormat,VersionResponse,DeliveryResponse,SearchResponse,ProblemDetails,ValidationError</models>
                                        <supportingFiles/>
                                    </globalProperties>

                                    <configOptions>
                                        <packageName>promptly_query</packageName>
                                        <projectName>promptly-query</projectName>
                                        <packageVersion>${query.sdk.version}</packageVersion>
                                    </configOptions>
                                </configuration>
                            </execution>

                            <!-- ─── TypeScript (fetch-based, framework-agnostic) SDK ─── -->
                            <execution>
                                <id>query-sdk-typescript</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <inputSpec>${openapi.bundled.spec}</inputSpec>
                                    <generatorName>typescript-fetch</generatorName>
                                    <output>${query.sdk.output}/typescript/promptly-query</output>

                                    <generateApiTests>false</generateApiTests>
                                    <generateModelTests>false</generateModelTests>

                                    <openapiNormalizer>
                                        <REF_AS_PARENT_IN_ALLOF>true</REF_AS_PARENT_IN_ALLOF>
                                    </openapiNormalizer>

                                    <globalProperties>
                                        <apis>PromptlyQuery</apis>
                                        <models>ProjectResponse,PromptResponse,PromptSummaryResponse,PromptStatus,ContentFormat,VersionResponse,DeliveryResponse,SearchResponse,ProblemDetails,ValidationError</models>
                                        <supportingFiles/>
                                    </globalProperties>

                                    <configOptions>
                                        <npmName>@promptly/query</npmName>
                                        <npmVersion>${query.sdk.version}</npmVersion>
                                        <supportsES6>true</supportsES6>
                                        <typescriptThreePlus>true</typescriptThreePlus>
                                    </configOptions>
                                </configuration>
                            </execution>

                            <!-- ─── Java Spring (WebClient-based, reactive) SDK ─── -->
                            <execution>
                                <id>query-sdk-java-spring</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <inputSpec>${openapi.bundled.spec}</inputSpec>
                                    <generatorName>java</generatorName>
                                    <output>${query.sdk.output}/java-spring/promptly-query</output>

                                    <apiPackage>com.spectrayan.promptly.query.api</apiPackage>
                                    <modelPackage>com.spectrayan.promptly.query.model</modelPackage>
                                    <invokerPackage>com.spectrayan.promptly.query</invokerPackage>

                                    <generateApiTests>false</generateApiTests>
                                    <generateModelTests>false</generateModelTests>

                                    <openapiNormalizer>
                                        <REF_AS_PARENT_IN_ALLOF>true</REF_AS_PARENT_IN_ALLOF>
                                    </openapiNormalizer>

                                    <globalProperties>
                                        <apis>PromptlyQuery</apis>
                                        <models>ProjectResponse,PromptResponse,PromptSummaryResponse,PromptStatus,ContentFormat,VersionResponse,DeliveryResponse,SearchResponse,ProblemDetails,ValidationError</models>
                                        <supportingFiles/>
                                    </globalProperties>

                                    <configOptions>
                                        <library>webclient</library>
                                        <useJakartaEe>true</useJakartaEe>
                                        <dateLibrary>java8</dateLibrary>
                                        <openApiNullable>false</openApiNullable>
                                        <groupId>com.spectrayan.promptly</groupId>
                                        <artifactId>promptly-query</artifactId>
                                        <artifactVersion>${query.sdk.version}</artifactVersion>
                                        <artifactDescription>Promptly Query SDK for Java Spring (read-only operations)</artifactDescription>
                                        <sourceFolder>src/main/java</sourceFolder>
                                        <serializationLibrary>jackson</serializationLibrary>
                                    </configOptions>
                                </configuration>
                            </execution>

                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
