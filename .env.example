# ═══════════════════════════════════════════════════════════════════════
# Promptly — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in the values:
#   cp .env.example .env
#
# Then launch:
#   docker compose -f docker-compose.prod.yml up -d

# ── Image Version ────────────────────────────────────────────────────
PROMPTLY_VERSION=latest

# ── Security ─────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── LLM Configuration ───────────────────────────────────────────────
PROMPTLY_LLM_PROVIDER=gemini
PROMPTLY_LLM_MODEL=gemini-2.5-flash
PROMPTLY_LLM_API_KEY=

# ── Deployment Mode ──────────────────────────────────────────────────
# 'saas' or 'self-hosted'
PROMPTLY_DEPLOYMENT_MODE=self-hosted
PROMPTLY_LLM_CREDENTIAL_ENCRYPTION_KEY=
