    "@nx/js": "22.6.0",
    "@nx/webpack": "22.6.0",
    "@nx/workspace": "22.6.0",
    "@playwright/test": "^1.59.1",
    "@schematics/angular": "~22.1.8",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^29.5.12",
