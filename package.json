{
  "name": "promptly",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start:backend": "JAVA_HOME=/usr/lib/jvm/java-23-openjdk-amd64 nx serve promptly-core",
    "start:frontend": "nx serve promptly",
    "start:all": "npx --yes concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "build:all": "nx run-many --target=build",
    "build:frontend": "nx build promptly",
    "build:backend": "JAVA_HOME=/usr/lib/jvm/java-23-openjdk-amd64 nx build promptly-core",
    "build:openapi": "JAVA_HOME=/usr/lib/jvm/java-23-openjdk-amd64 mvn generate-sources -f libs/shared/openapi-spec/pom.xml",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "./scripts/docker-publish.sh latest --no-push",
    "docker:publish": "./scripts/docker-publish.sh",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "seed:db": "docker exec -i promptly-mongodb mongosh promptly",
    "lighthouse": "lhci autorun --config=apps/e2e/promptly-perf/lighthouse/lighthouserc.json",
    "graph": "nx graph"
  },
